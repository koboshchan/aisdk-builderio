{
  "name": "ai-sdk-provider-builder",
  "version": "0.1.4",
  "description": "Builder.io AI SDK provider for language models",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/provider-utils": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "ai": "^6.0.303",
    "js-tiktoken": "^1.0.21",
    "tsup": "^8.0.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  }
}
